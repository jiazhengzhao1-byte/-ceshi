{
  "policy": {
    "defaultMode": "blocked",
    "stackShortDurations": true,
    "shortDurationCapMinutes": 120,
    "dailyQuota": {
      "oneHour": 1,
      "twoHours": 1
    }
  },
  "logging": {
    "enabled": true,
    "level": "info"
  },
  "storage": {
    "basePath": "%ProgramData%/FocusBlocker"
  }
}
